{
  "name": "wcag-ai-helper",
  "displayName": "WCAG Accessibility Helper",
  "description": "A VS Code extension for real-time WCAG accessibility checking with optional AI-based suggestions.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:wcag-ai-helper.scanFile",
    "onCommand:wcag-ai-helper.askAiSuggestion"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wcag-ai-helper.scanFile",
        "title": "Scan current file for accessibility issues"
      },
      {
        "command": "wcag-ai-helper.askAiSuggestion",
        "title": "Ask AI for accessibility suggestion"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "WCAG AI Helper",
      "properties": {
        "wcag-ai-helper.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API key used to generate accessibility suggestions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.46.3",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
